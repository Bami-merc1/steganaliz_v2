# Copy to .env and fill in values — NEVER commit .env to git

# MongoDB Atlas connection string
# Get from: Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/steganaliz?retryWrites=true&w=majority

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# Your deployed frontend URL (no trailing slash)
FRONTEND_ORIGIN=https://steganaliz.emerc.site

# Server port (Render sets this automatically)
PORT=4000

# Environment
NODE_ENV=development